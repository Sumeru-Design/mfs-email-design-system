{
  "site": {
    "title": "MyFreeStyle Email Design System",
    "short": "Email Design System",
    "version": "1.0",
    "updated": "2026-10-06",
    "figmaFile": "https://www.figma.com/design/zF8mGxQX2LtDOb6gT2MTtM/Templates-v-s-Modules",
    "intro": "30 modules across 6 categories, distilled from the Voucher Optimization (1–19) and Nudge (1–7) emails. Every module is a locked layout: swap the image and edit the text — nothing else. Each one ships as live, table-based HTML that renders at Desktop 600px and Mobile 375px, in Light and Dark mode."
  },
  "guidelines": [
    {
      "title": "Locked layouts",
      "body": "Modules are fixed compositions. Swap images and edit copy only; don’t re-order rows, change colours or add elements. If a layout doesn’t fit, pick a different module."
    },
    {
      "title": "Email order",
      "body": "Header → one Hero → up to four or five Body modules → Customer Support → optional Poll → Disclaimer. Support and Disclaimer are mandatory in every email."
    },
    {
      "title": "Retina images",
      "body": "Export every image at 2× its displayed size. Specs list the 1× slot size; the HTML displays at 1× with explicit width and height."
    },
    {
      "title": "Character counts",
      "body": "Limits are approximations based on the placeholder copy and the text box width. Real words vary — always check the Mobile preview for wrapping."
    },
    {
      "title": "Fonts",
      "body": "Emails use Calibri, with Arial as the fallback for Gmail and other clients without Calibri. Don’t use web fonts in email."
    },
    {
      "title": "Merge fields & MLR",
      "body": "[Magenta bracketed] text marks dynamic merge fields or MLR-flagged copy. Magenta is an annotation colour only — it must never ship."
    },
    {
      "title": "Accessibility",
      "body": "Keep text at WCAG AA contrast against its background (badges on each colour show the ratio). Every meaningful image needs alt text; never put essential copy in an image."
    },
    {
      "title": "Dark mode",
      "body": "Inboxes apply dark mode themselves; emails carry no dark-mode CSS. The Dark preview emulates it, mapping brand colours to the Dark token values and inverting other light backgrounds, the way Apple Mail and Outlook do. Gmail’s results vary."
    }
  ],
